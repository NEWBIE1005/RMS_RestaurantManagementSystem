@startuml Analysis_03_Module2_ClassDiagram
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 55

title HÌNH 3.7: BIỂU ĐỒ LỚP PHA PHÂN TÍCH - MODULE 2: ĐẶT MÓN ONLINE CHO KHÁCH HÀNG

class GDChinhNVBH <<boundary>> {
    - subDatMonOnline
    - subXacNhanDatBan
    - subThanhToan
}

class GDTimBanDat <<boundary>> {
    - inTenHoacSDT
    - subTimBan
    - outsubDSBanDat
    - subQuayLai
}

class GDChonMonOnline <<boundary>> {
    - outBanDaChon
    - inTenMon
    - inLoaiMon
    - subTimMon
    - outDSMonTimThay
    - inSoLuong
    - subThemMon
    - outsubDSMonDaGoi
    - subXacNhan
}

class GDXacNhanGoiMon <<boundary>> {
    - outThongTinBan
    - outDSMonDaGoi
    - outTongTien
    - inGhiChu
    - subXacNhanLuu
    - subQuayLai
    - outThongBao
}

class User <<entity>> {
    - username
    - password
    - fullName
    - phone
    - email
    - address
    - role
}

class Staff <<entity>> {
    - staffCode
    - position
    - salary
}

class Customer <<entity>> {
    - customerCode
    - membershipLevel
    - rewardPoints
}

class Table <<entity>> {
    - tableNumber
    - capacity
    - floor
    - status
    - description
}

class Reservation <<entity>> {
    - bookingTime
    - numberOfGuests
    - status
    - note
    + searchBookedTables()
    + getReservationById()
}

class Category <<entity>> {
    - code
    - name
    - description
    + getAllCategories()
}

class Dish <<entity>> {
    - code
    - name
    - price
    - unit
    - description
    - status
    + searchDish()
    + getDishById()
}

class OrderedDish <<entity>> {
    - quantity
    - price
    - note
    + createOrderedDish()
}

class OrderOnline <<entity>> {
    - orderCode
    - orderTime
    - totalAmount
    - status
    - note
    + saveOrderOnline()
}

GDChinhNVBH -right-> GDTimBanDat
GDTimBanDat -right-> GDChonMonOnline
GDChonMonOnline -right-> GDXacNhanGoiMon

GDChinhNVBH -down-> Staff
GDTimBanDat -down-> Reservation
GDChonMonOnline -down-> Reservation
GDChonMonOnline -down-> Category
GDChonMonOnline -down-> Dish
GDChonMonOnline -down-> OrderedDish
GDXacNhanGoiMon -down-> OrderOnline

Staff -down-|> User
Customer -down-|> User
Customer "1" -- "0..*" Reservation
Table "1" -- "0..*" Reservation
Category "1" o-- "0..*" Dish
Reservation "1" -- "0..*" OrderOnline
OrderOnline "1" *-- "1..*" OrderedDish
Dish "1" -- "0..*" OrderedDish

@enduml
