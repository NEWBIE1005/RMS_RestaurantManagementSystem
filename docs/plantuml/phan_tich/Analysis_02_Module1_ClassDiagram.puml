@startuml Analysis_02_Module1_ClassDiagram
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55

title HÌNH 3.6: BIỂU ĐỒ LỚP PHA PHÂN TÍCH - MODULE 1: NV QUẢN LÝ SỬA THÔNG TIN MÓN ĂN

class GDChinhNVQL <<boundary>> {
    - subQLMonAn
    - subTaoCombo
    - subXemThongKe
    - subDangXuat
}

class GDQuanLyMonAn <<boundary>> {
    - inChucNang
    - subTiepTuc
    - subQuayLai
}

class GDTimKiemMonAn <<boundary>> {
    - inTenMon
    - subTimKiem
    - outsubDSMonAn
    - subQuayLai
}

class GDSuaMonAn <<boundary>> {
    - inoutTenMon
    - inoutGia
    - inoutDonVi
    - inoutTheLoai
    - inoutMoTa
    - inoutTrangThai
    - subLuu
    - subHuy
    - outThongBao
}

class User <<entity>> {
    - username
    - password
    - fullName
    - phone
    - email
    - address
    - role
}

class Staff <<entity>> {
    - staffCode
    - position
    - salary
}

class ManagementStaff <<entity>> {
}

class Category <<entity>> {
    - code
    - name
    - description
    + getAllCategories()
}

class Dish <<entity>> {
    - code
    - name
    - price
    - unit
    - description
    - status
    - image
    + searchDishByName()
    + getDishById()
    + updateDish()
}

GDChinhNVQL -right-> GDQuanLyMonAn
GDQuanLyMonAn -right-> GDTimKiemMonAn
GDTimKiemMonAn -right-> GDSuaMonAn

GDChinhNVQL -down-> ManagementStaff
GDTimKiemMonAn -down-> Dish
GDSuaMonAn -down-> Dish
GDSuaMonAn -down-> Category

ManagementStaff -down-|> Staff
Staff -down-|> User
Category "1" o-- "0..*" Dish

@enduml
