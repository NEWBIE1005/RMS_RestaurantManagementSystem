@startuml Design_03_Module1_ClassDiagram
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 35
skinparam ranksep 45

title HÌNH 4.6: BIỂU ĐỒ LỚP THIẾT KẾ CHI TIẾT MODULE 1 - SỬA THÔNG TIN MÓN ĂN

package "Tầng Giao diện (View - JSP)" {
    class gdChinhNVQL_jsp <<boundary>> {
        - subQLMonAn : link
        - nvql : Staff
    }

    class gdQuanLyMonAn_jsp <<boundary>> {
        - radChucNang : radio
        - btnTiepTuc : submit
        - btnQuayLai : link
    }

    class gdTimKiemMonAn_jsp <<boundary>> {
        - txtTenMon : text
        - btnTimKiem : submit
        - tblKetQua : Table
        - linkSua : link
        - listMonAn : ArrayList<Dish>
    }

    class gdSuaMonAn_jsp <<boundary>> {
        - txtCode : text
        - txtName : text
        - cbCategory : Select
        - txtPrice : text
        - txtUnit : text
        - cbStatus : Select
        - txtDescription : textarea
        - btnLuu : submit
        - btnHuy : link
        - monan : Dish
        - listCategory : ArrayList<Category>
    }

    class doSuaMonAn_jsp <<boundary>> {
        - monan : Dish
        - ketQua : boolean
    }

    class gdThongBao_jsp <<boundary>> {
        - lblThongBao : text
        - btnOK : link
    }
}

package "Tầng Truy xuất Dữ liệu (DAO)" {
    class DAO <<dao>> {
        # con : Connection
        + DAO()
    }

    class DishDAO <<dao>> {
        + DishDAO()
        + searchDishByName(name : String) : ArrayList<Dish>
        + getDishById(id : int) : Dish
        + checkDuplicateName(id : int, name : String) : boolean
        + updateDish(dish : Dish) : boolean
    }

    class CategoryDAO <<dao>> {
        + CategoryDAO()
        + getAllCategories() : ArrayList<Category>
    }
}

package "Tầng Thực thể (Model)" {
    class User <<entity>> {
        - id : int
        - username : String
        - password : String
        - fullName : String
        - phone : String
        - email : String
        - address : String
        - role : String
    }

    class Staff <<entity>> {
        - staffCode : String
        - position : String
        - salary : float
    }

    class Category <<entity>> {
        - id : int
        - code : String
        - name : String
        - description : String
    }

    class Dish <<entity>> {
        - id : int
        - code : String
        - name : String
        - price : float
        - unit : String
        - description : String
        - status : String
        - image : String
        - category : Category
    }
}

gdChinhNVQL_jsp -right-> gdQuanLyMonAn_jsp
gdQuanLyMonAn_jsp -right-> gdTimKiemMonAn_jsp
gdTimKiemMonAn_jsp -down-> gdSuaMonAn_jsp
gdSuaMonAn_jsp -right-> doSuaMonAn_jsp
doSuaMonAn_jsp -right-> gdThongBao_jsp

DishDAO -up-|> DAO
CategoryDAO -up-|> DAO

gdTimKiemMonAn_jsp -down..> DishDAO
gdSuaMonAn_jsp -down..> DishDAO
gdSuaMonAn_jsp -down..> CategoryDAO
doSuaMonAn_jsp -down..> DishDAO

gdChinhNVQL_jsp -down-> Staff
gdTimKiemMonAn_jsp -down-> Dish
gdSuaMonAn_jsp -down-> Dish
gdSuaMonAn_jsp -down-> Category
doSuaMonAn_jsp -down-> Dish

DishDAO -down-> Dish
CategoryDAO -down-> Category

Staff -down-|> User
Category "1" o-- "0..*" Dish

@enduml
