@startuml Design_01_EntityClassDiagram
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 38
skinparam ranksep 48

title HÌNH 4.1: BIỂU ĐỒ THIẾT KẾ LỚP THỰC THỂ TOÀN HỆ THỐNG RMS\n(Bổ sung id, kiểu dữ liệu Java, lớp chuyên biệt/thống kê, hợp thành & thuộc tính đối tượng)

class User {
    - id : int
    - username : String
    - password : String
    - fullName : String
    - phone : String
    - email : String
    - address : String
    - role : String
}

class Staff {
    - staffCode : String
    - position : String
    - salary : float
}

class ManagementStaff {
}

class WarehouseStaff {
}

class SaleStaff {
}

class Customer {
    - customerCode : String
    - membershipLevel : String
    - rewardPoints : int
}

class CustomerStat {
    - totalReservations : int
    - totalSpent : float
}

class Category {
    - id : int
    - code : String
    - name : String
    - description : String
    - dsDish : Dish[]
}

class Dish {
    - id : int
    - code : String
    - name : String
    - price : float
    - unit : String
    - description : String
    - status : String
    - image : String
    - category : Category
}

class DishStat {
    - totalOrderedQty : int
    - totalRevenue : float
}

class Combo {
    - id : int
    - name : String
    - discountRate : float
    - totalPrice : float
    - description : String
    - dsComboDish : ComboDish[]
}

class ComboDish {
    - id : int
    - combo : Combo
    - dish : Dish
    - quantity : int
}

class Table {
    - id : int
    - tableNumber : String
    - capacity : int
    - floor : int
    - status : String
    - description : String
}

class Reservation {
    - id : int
    - customer : Customer
    - table : Table
    - bookingTime : Date
    - numberOfGuests : int
    - status : String
    - note : String
}

class OrderOnline {
    - id : int
    - orderCode : String
    - reservation : Reservation
    - orderTime : Date
    - totalAmount : float
    - status : String
    - note : String
    - dsMonGoi : OrderedDish[]
}

class OrderedDish {
    - id : int
    - dish : Dish
    - quantity : int
    - price : float
    - note : String
}

class Bill {
    - id : int
    - billCode : String
    - orderOnline : OrderOnline
    - staff : SaleStaff
    - paymentTime : Date
    - totalAmount : float
    - discount : float
    - finalAmount : float
    - paymentMethod : String
}

class Ingredient {
    - id : int
    - code : String
    - name : String
    - unit : String
    - unitPrice : float
    - stockQuantity : float
    - minStockThreshold : float
}

class IngredientStat {
    - totalImportedQty : float
    - totalImportCost : float
}

class Supplier {
    - id : int
    - name : String
    - address : String
    - phone : String
    - email : String
    - taxCode : String
}

class SupplierStat {
    - totalReceipts : int
    - totalSupplyValue : float
}

class ImportReceipt {
    - id : int
    - receiptCode : String
    - supplier : Supplier
    - staff : WarehouseStaff
    - importDate : Date
    - totalAmount : float
    - note : String
    - dsChiTiet : ImportDetail[]
}

class ImportDetail {
    - id : int
    - ingredient : Ingredient
    - quantity : float
    - importPrice : float
    - subTotal : float
}

Staff --|> User
Customer --|> User
ManagementStaff --|> Staff
WarehouseStaff --|> Staff
SaleStaff --|> Staff

CustomerStat --|> Customer
Dish <|-- DishStat
IngredientStat --|> Ingredient
SupplierStat --|> Supplier

Category "1" o-- "0..*" Dish
Combo "1" *-- "1..*" ComboDish
ComboDish "0..*" --> "1" Dish

Customer "1" -- "0..*" Reservation
Table "1" -- "0..*" Reservation

Reservation "1" -- "0..*" OrderOnline
OrderOnline "1" *-- "1..*" OrderedDish
OrderedDish "0..*" --> "1" Dish

OrderOnline "1" -- "0..1" Bill
SaleStaff "1" -- "0..*" Bill

Supplier "1" -- "0..*" ImportReceipt
WarehouseStaff "1" -- "0..*" ImportReceipt
ImportReceipt "1" *-- "1..*" ImportDetail
ImportDetail "0..*" --> "1" Ingredient

@enduml
