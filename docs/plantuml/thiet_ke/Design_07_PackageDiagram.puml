@startuml Design_07_PackageDiagram
skinparam packageStyle rectangle
skinparam monochrome true
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 48

title HÌNH 4.15: BIỂU ĐỒ THIẾT KẾ GÓI (PACKAGE DIAGRAM) TOÀN HỆ THỐNG RMS

package "webapp (View - JSP & CSS)" as pkg_view {
    package "chung" {
        [gddangnhap.jsp]
        [doDangnhap.jsp]
        [dangxuat.jsp]
    }
    package "nvql" {
        [gdChinhNVQL.jsp]
        [gdQuanLyMonAn.jsp]
        [gdTimKiemMonAn.jsp]
        [gdSuaMonAn.jsp / doSuaMonAn.jsp]
        [gdThemMonAn.jsp / doThemMonAn.jsp]
        [gdQuanLyCombo.jsp / gdThongKe.jsp]
        [gdThongBao.jsp]
    }
    package "khachhang" {
        [gdChinhKH.jsp]
        [gdDatBan.jsp / doDatBan.jsp]
        [gdTimBanDat.jsp]
        [gdChonMonOnline.jsp]
        [gdXacNhanGoiMon.jsp / doLuuGoiMon.jsp]
        [gdTraCuuThucDon.jsp / gdLichSuDon.jsp]
        [gdThongBaoGoiMon.jsp]
    }
    package "nvbh_nvkho" {
        [gdChinhNVBH.jsp]
        [gdChinhNVKho.jsp]
    }
}

package "com.rms.launcher & util" as pkg_launcher {
    [LocalTomcatServer]
    [FormatUtil]
}

package "com.rms.dao (Data Access Objects)" as pkg_dao {
    [DAO]
    [UserDAO]
    [CategoryDAO]
    [DishDAO]
    [TableDAO]
    [ReservationDAO]
    [OrderOnlineDAO]
    [OrderedDishDAO]
    [ComboDAO]
    [BillDAO]
    [WarehouseDAO]
    [StatDAO]
}

package "unittest (JUnit 4)" as pkg_test {
    [TestDishDAO]
    [TestReservationDAO]
    [TestOrderOnlineDAO]
    [TestExtendedDAOs]
}

package "com.rms.model (Entities / JavaBeans)" as pkg_model {
    [User / Staff / Customer]
    [Category / Dish / Combo / ComboDish]
    [Table / Reservation / OrderOnline / OrderedDish / Bill]
    [Ingredient / Supplier / ImportReceipt / ImportDetail]
    [DishStat / IngredientStat / CustomerStat / SupplierStat]
}

pkg_view -down..> pkg_launcher
pkg_view -down..> pkg_dao
pkg_view -down..> pkg_model
pkg_launcher -down..> pkg_dao
pkg_dao -down..> pkg_model
pkg_test -down..> pkg_dao
pkg_test -down..> pkg_model

chung -[hidden]down-> nvql
nvbh_nvkho -[hidden]down-> khachhang

@enduml
