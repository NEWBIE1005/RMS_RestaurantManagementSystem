@startuml Design_04a_Module2_UIFlow
skinparam monochrome true
skinparam shadowing false
skinparam defaultTextAlignment center

title HÌNH 4.7: THIẾT KẾ GIAO DIỆN MODULE 2 - KHÁCH HÀNG ĐẶT MÓN ONLINE

package "gdChinhKH.jsp\n(Trang chủ Khách hàng)" as P0 {
  class "Trang chủ Khách hàng\n--\n[Tìm kiếm món / bàn]\n[Đặt bàn trực tuyến]\n[Đặt món online] (click)" as UI0
}

package "gdTimBanDat.jsp\n(Tìm bàn theo Tên / SĐT)" as P1 {
  class "Tìm bàn đã đặt\n--\nTên KH hoặc SĐT: [0987654321] [Tìm bàn]\n--\nBảng bàn đã đặt:\nSTT | Mã đặt | Khách hàng | Bàn | Giờ | Chọn\n1 | #RES-01 | Hà Anh Khôi | Bàn 08 | 19:30 | [Chọn]" as UI1
}

package "gdChonMonOnline.jsp\n(Tìm món lặp lại, nhập SL & danh sách gọi)" as P2 {
  class "Đặt món online - Bàn 08\n--\nTên món: [____]  Loại: [Tất cả v]  [Tìm món]\n--\nKết quả món ăn:\nLẩu thái | 380k | SL: [1] | [Thêm]\n--\nDanh sách món đã chọn:\n1. Lẩu thái | SL: 1 | 380,000\nTổng cộng: 380,000 VNĐ\n--\n[Xác nhận danh sách món]" as UI2
}

package "gdXacNhanGoiMon.jsp\n(Xác nhận cuối danh sách)" as P3 {
  class "Xác nhận đơn gọi món\n--\nBàn 08 - Khách: Hà Anh Khôi (0987654321)\nDanh sách món & Tổng tiền: 380,000 VNĐ\nGhi chú: [Ít cay]\n--\n[Xác nhận đặt món]  [Quay lại chọn thêm]" as UI3
}

package "gdThongBaoGoiMon.jsp\n(Thông báo lưu thành công)" as P4 {
  class "Thông báo\n--\nĐặt món online thành công!\nMã đơn: #ORD-2026-001\n--\n[Về trang chủ]" as UI4
}

UI0 -right-> UI1 : click Đặt món online
UI1 -down-> UI2 : click [Chọn] bàn đặt
UI2 -right-> UI3 : click [Xác nhận danh sách món]
UI3 -down-> UI4 : click [Xác nhận đặt món] (doLuuGoiMon.jsp)
UI4 -up-> UI0 : về trang chủ

@enduml
