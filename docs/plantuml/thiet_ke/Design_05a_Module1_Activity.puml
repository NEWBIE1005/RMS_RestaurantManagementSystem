repeat
  :Nhập thông tin mới & click Lưu;
  if (Dữ liệu hợp lệ?) then (Không)
    :Hiển thị thông báo lỗi nhập liệu;
  endif
repeat while (Dữ liệu hợp lệ?) is (Không)

|Xử lí tại doSuaMonAn.jsp|
:Đóng gói đối tượng Dish;
:DishDAO: updateDish(dish);

|Xử lí tại gdThongBao.jsp|
:Hiển thị thông báo cập nhật thành công;
:Click OK quay về trang chủ;
